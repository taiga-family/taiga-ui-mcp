{
    "extends": "@taiga-ui/tsconfig",
    "compilerOptions": {
        "baseUrl": "./",
        "checkJs": false,
        "esModuleInterop": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist",
        "target": "ES2022",
        "typeRoots": ["node_modules/@types", "node_modules/@taiga-ui/tsconfig"],
        "types": ["node"]
    },
    "include": ["src/**/*", "test/**/*"],
    "exclude": ["node_modules"]
}
